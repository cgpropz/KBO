{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/reconcile-subscriptions",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/nfl", "destination": "/nfl-player-props", "statusCode": 301 },
    { "source": "/wnba", "destination": "/wnba-player-props", "statusCode": 301 },
    { "source": "/nba", "destination": "/nba-player-props", "statusCode": 301 },
    { "source": "/nhl", "destination": "/nhl-player-props", "statusCode": 301 },
    { "source": "/kbo", "destination": "/kbo-player-props", "statusCode": 301 },
    { "source": "/plans", "destination": "/pricing", "statusCode": 301 },
    { "source": "/board", "destination": "/kbo-player-props", "statusCode": 301 },
    { "source": "/app", "destination": "/", "statusCode": 301 },
    { "source": "/start-here", "destination": "/guides/start-here", "statusCode": 301 },
    { "source": "/how-cg-score", "destination": "/guides/cg-score", "statusCode": 301 },
    { "source": "/blog", "destination": "/guides", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/guides", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/discord-auth", "destination": "/api/discord/auth" },
    { "source": "/api/discord-callback", "destination": "/api/discord/callback" },
    { "source": "/api/discord-checkout", "destination": "/api/discord/checkout" },
    { "source": "/api/discord-disconnect", "destination": "/api/discord/disconnect" },
    { "source": "/api/discord-backfill", "destination": "/api/discord/backfill" },
    { "source": "/api/nba-access", "destination": "/api/league-access/nba" },
    { "source": "/api/nhl-access", "destination": "/api/league-access/nhl" },
    { "source": "/api/checkout-session", "destination": "/api/checkout/session" },
    { "source": "/api/weekly-checkout", "destination": "/api/checkout/weekly" },
    { "source": "/api/billing-portal", "destination": "/api/checkout/portal" },
    { "source": "/kbo-player-props", "destination": "/kbo-player-props.html" },
    { "source": "/nfl-player-props", "destination": "/nfl-player-props.html" },
    { "source": "/wnba-player-props", "destination": "/wnba-player-props.html" },
    { "source": "/nba-player-props", "destination": "/nba-player-props.html" },
    { "source": "/nhl-player-props", "destination": "/nhl-player-props.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/policies", "destination": "/policies.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/responsible-gaming", "destination": "/responsible-gaming.html" },
    { "source": "/states-not-available", "destination": "/states-not-available.html" },
    { "source": "/guides/cg-score", "destination": "/guides/cg-score.html" },
    { "source": "/guides/start-here", "destination": "/guides/start-here.html" },
    { "source": "/status.json", "destination": "/api/data?ds=board_status" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
