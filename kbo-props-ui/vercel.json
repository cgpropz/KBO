{
  "crons": [
    {
      "path": "/api/reconcile-subscriptions",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/discord-auth", "destination": "/api/discord/auth" },
    { "source": "/api/discord-callback", "destination": "/api/discord/callback" },
    { "source": "/api/discord-checkout", "destination": "/api/discord/checkout" },
    { "source": "/api/discord-disconnect", "destination": "/api/discord/disconnect" },
    { "source": "/api/discord-backfill", "destination": "/api/discord/backfill" },
    { "source": "/api/nba-access", "destination": "/api/league-access/nba" },
    { "source": "/api/nhl-access", "destination": "/api/league-access/nhl" },
    { "source": "/api/checkout-session", "destination": "/api/checkout/session" },
    { "source": "/api/weekly-checkout", "destination": "/api/checkout/weekly" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|data/).*)",
      "destination": "/index.html"
    }
  ]
}
